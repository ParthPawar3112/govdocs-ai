# Copy this file to .env before running the backend.
# On Windows (PowerShell):   copy .env.example .env
# On Windows (Command Prompt): copy .env.example .env

APP_NAME=GovDocs AI
ENV=development

# SQLite - no server, no password, no separate install needed.
# This creates a file named govdocs.db inside the backend/ folder
# the first time the server starts.
DATABASE_URL=sqlite:///./govdocs.db

# Must match the URL the Vite dev server prints when you run npm run dev.
FRONTEND_ORIGIN=http://localhost:5173

# JWT signing configuration for the Phase 2 authentication module.
# Replace the development value with a long random secret before deployment.
JWT_SECRET_KEY=change-this-development-secret-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
